{
  "lab_id": "lab101",
  "title": "lab 101 - 2026",
  "description": "Launch an AWS EC2 Linux Instance (Amazon Linux 2023)",

  "lab_objective": {
    "description": "By the end of this lab, you will be able to:",
    "objectives": [
      "Log in to the AWS Management Console",
      "Launch an Amazon EC2 Linux instance",
      "Configure networking and security",
      "Connect to the instance using SSH",
      "Configure apache webserver",
      "Verify the instance and webserver is working",
      "Terminate the instance to avoid unnecessary charges"
    ]
  },

  "tasks": [
    {
      "task_number": 1,
      "title": "Login to AWS Management Console",
      "steps": [
        "Open your browser",
        "Go to https://console.aws.amazon.com",
        "Login using your AWS credentials",
        "After login you will see the AWS Console"
      ]
    },

    {
      "task_number": 2,
      "title": "Select AWS Region",
      "region": {
        "name": "US East (N. Virginia)",
        "code": "us-east-1"
      },
      "instruction": "Keep the same region throughout the lab."
    },

    {
      "task_number": 3,
      "title": "Open EC2 Dashboard",
      "steps": [
        "Search for EC2",
        "Open the EC2 Dashboard"
      ]
    },

    {
      "task_number": 4,
      "title": "Launch EC2 Instance",
      "steps": [
        "Click Launch Instance"
      ],

      "instance_configuration": {
        "name": "webserver01",
        "ami": "Amazon Linux 2023",
        "architecture": "64-bit (x86)",
        "instance_type": "t3.micro"
      }
    },

    {
      "task_number": 5,
      "title": "Create Key Pair",

      "key_pair": {
        "name": "webserver01-key",
        "type": "RSA",
        "private_key_format": ".pem"
      },

      "steps": [
        "Create a new Key Pair",
        "Download and save the key pair"
      ]
    },

    {
      "task_number": 6,
      "title": "Configure Network Settings",

      "network_configuration": {
        "vpc": "Default VPC",
        "subnet": "Public Subnet",
        "auto_assign_public_ip": "Enabled"
      }
    },

    {
      "task_number": 7,
      "title": "Create Security Group",

      "security_group": {
        "name": "my-sg1",

        "inbound_rules": [
          {
            "type": "SSH",
            "protocol": "TCP",
            "port": "22",
            "source": "My IP"
          }
        ]
      }
    },

    {
      "task_number": 8,
      "title": "Configure Storage",

      "storage": {
        "volume_size": "8 GB",
        "volume_type": "gp3"
      },

      "instruction": "Leave the default storage configuration."
    },

    {
      "task_number": 9,
      "title": "Launch Instance",

      "steps": [
        "Click Launch Instance",
        "Open the Instances page",
        "Wait until instance shows Running state"
      ],

      "verification": [
        "Instance State: Running",
        "Status Checks: 2/2 Passed",
        "Some instance types may display 3/3 checks passed"
      ]
    },

    {
      "task_number": 10,
      "title": "Copy Public IPv4 Address",

      "instruction": "Copy the Public IPv4 Address of the instance. You need this address for SSH connection and web testing."
    },

    {
      "task_number": 11,
      "title": "Connect EC2 Instance Using Private Key",

      "connection_method": {
        "tool": "Mobaxterm",
        "mac_users": "Use Terminal"
      },

      "steps": [
        "Open Mobaxterm",
        "Click Session",
        "Click SSH",
        "Add Public IP of EC2 instance as Remote host",
        "Enter username ec2-user",
        "Open Advanced SSH settings",
        "Enable Use private key",
        "Select the private key from Downloads folder",
        "Double click the private key",
        "Click OK",
        "Verify successful login"
      ]
    },

    {
      "task_number": 12,
      "title": "Test SSH Access From Command Line",

      "command": "ssh -i \"C:\\<path>\\webserver01-key.pem\" ec2-user@<Public-IP>"
    },

    {
      "task_number": 13,
      "title": "Explore EC2 Linux Instance",

      "commands": [
        {
          "purpose": "Verify logged-in user",
          "command": "whoami"
        },
        {
          "purpose": "Display hostname",
          "command": "hostname"
        },
        {
          "purpose": "Display operating system information",
          "command": "cat /etc/os-release"
        },
        {
          "purpose": "Display kernel version",
          "command": "uname -r"
        },
        {
          "purpose": "Display disk usage",
          "command": "df -h"
        },
        {
          "purpose": "Display memory usage",
          "command": "free -h"
        }
      ]
    },

    {
      "task_number": 14,
      "title": "Configure Apache Web Server",

      "steps": [
        {
          "action": "Install Apache web server",
          "command": "sudo dnf install httpd -y"
        },
        {
          "action": "Start Apache service",
          "command": "sudo systemctl start httpd"
        },
        {
          "action": "Enable Apache service at boot",
          "command": "sudo systemctl enable httpd"
        },
        {
          "action": "Verify Apache service status",
          "command": "sudo systemctl status httpd"
        },
        {
          "action": "Create test web page",
          "command": "echo \"<h1>Welcome to my AWS webserver01 EC2 instance</h1>\" >> /var/www/html/index.html"
        }
      ]
    },

    {
      "task_number": 15,
      "title": "Test Web Server Access",

      "steps": [
        "Open browser",
        "Enter http://<Public-IP of webserver01 instance>",
        "Verify web page is displayed"
      ],

      "expected_result": "Initially the webpage is expected not accessible.",

      "troubleshooting": {
        "action": "Edit Security Group",

        "add_inbound_rule": {
          "type": "HTTP",
          "protocol": "TCP",
          "port": "80",
          "source": "0.0.0.0/0"
        }
      }
    },

    {
      "task_number": 16,
      "title": "Disconnect From EC2 Instance",

      "steps": [
        "Disconnect from EC2 instance using Mobaxterm, CLI, or Terminal"
      ]
    },

    {
      "task_number": 17,
      "title": "Terminate EC2 Instance",

      "steps": [
        "Return to EC2 Console",
        "Select Instances",
        "Select webserver01 instance",
        "Click Instance State",
        "Choose Terminate Instance"
      ]
    },

    {
      "task_number": 18,
      "title": "Delete Security Group",

      "steps": [
        "Navigate to EC2 Console",
        "Open Security Groups",
        "Select my-sg1",
        "Delete Security Group"
      ],

      "condition": "After instance is terminated"
    },

    {
      "task_number": 19,
      "title": "Delete Key Pair",

      "steps": [
        "Navigate to EC2 Console",
        "Open Key Pairs",
        "Select webserver01-key",
        "Delete Key Pair"
      ]
    }
  ],

  "completion_message": "Cool!!!! Great job."
}
